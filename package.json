{
  "name": "claude-task-monitor",
  "displayName": "Claude Task Monitor",
  "description": "VS Code 侧边栏实时监控本机所有 Claude Code CLI 会话 🟢🟡🔴 —— 红点出现 = 有会话在等你授权,不再切窗口轮询",
  "version": "0.1.9",
  "publisher": "codewithwu-cn",
  "license": "MIT",
  "icon": "resources/icons/icon.png",
  "engines": { "vscode": "^1.86.0" },
  "categories": ["Other"],
  "keywords": [
    "claude-code",
    "claude",
    "ai",
    "productivity",
    "monitor",
    "dashboard",
    "session"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/codewithwu/Claude-Task-Monitor.git"
  },
  "bugs": {
    "url": "https://github.com/codewithwu/Claude-Task-Monitor/issues"
  },
  "homepage": "https://github.com/codewithwu/Claude-Task-Monitor#readme",
  "galleryBanner": {
    "color": "#0e639c"
  },
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeTaskMonitor",
          "title": "Claude Task Monitor",
          "icon": "resources/icons/sidebar.svg"
        }
      ]
    },
    "views": {
      "claudeTaskMonitor": [
        {
          "id": "claudeTaskMonitor.sessionsView",
          "name": "Sessions",
          "icon": "$(pulse)",
          "contextualTitle": "Claude Task Monitor"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeTaskMonitor.sessionsView",
        "contents": "当前无活跃 Claude Code 会话。\n\n启动 `claude` 后会自动出现。\n\n首次使用？激活时已自动安装 hook 到 ~/.claude/settings.json。\n确认 `jq` 已安装（macOS `brew install jq`，Debian/Ubuntu `apt install jq`）。"
      }
    ],
    "commands": [
      {
        "command": "claudeTaskMonitor.focusSessionsView",
        "title": "Claude Task Monitor: Focus Sessions View",
        "category": "Claude Task Monitor"
      },
      {
        "command": "claudeTaskMonitor.copySessionId",
        "title": "Copy Session ID",
        "category": "Claude Task Monitor"
      },
      {
        "command": "claudeTaskMonitor.copyAsJson",
        "title": "Copy Session as JSON",
        "category": "Claude Task Monitor"
      },
      {
        "command": "claudeTaskMonitor.openInTerminal",
        "title": "Open in Integrated Terminal",
        "category": "Claude Task Monitor"
      },
      {
        "command": "claudeTaskMonitor.revealInExplorer",
        "title": "Reveal in File Explorer",
        "category": "Claude Task Monitor"
      },
      {
        "command": "claudeTaskMonitor.archiveSession",
        "title": "Archive Session Now",
        "category": "Claude Task Monitor"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "claudeTaskMonitor.copySessionId",
          "when": "view == claudeTaskMonitor.sessionsView",
          "group": "1_session@1"
        },
        {
          "command": "claudeTaskMonitor.copyAsJson",
          "when": "view == claudeTaskMonitor.sessionsView",
          "group": "1_session@2"
        },
        {
          "command": "claudeTaskMonitor.openInTerminal",
          "when": "view == claudeTaskMonitor.sessionsView",
          "group": "2_open@1"
        },
        {
          "command": "claudeTaskMonitor.revealInExplorer",
          "when": "view == claudeTaskMonitor.sessionsView",
          "group": "2_open@2"
        },
        {
          "command": "claudeTaskMonitor.archiveSession",
          "when": "view == claudeTaskMonitor.sessionsView",
          "group": "3_lifecycle@1"
        }
      ]
    },
    "configuration": {
      "title": "Claude Task Monitor",
      "properties": {
        "claudeTaskMonitor.staleHours": {
          "type": "number",
          "default": 24,
          "description": "会话文件 mtime 超过该小时数视为僵尸, 启动时自动归档到 .ended/"
        },
        "claudeTaskMonitor.notifyDedupeSeconds": {
          "type": "number",
          "default": 30,
          "description": "同一 session 在该秒数内不重复弹等待权限通知"
        },
        "claudeTaskMonitor.refreshIntervalMs": {
          "type": "number",
          "default": 1000,
          "description": "侧边栏持续时间显示的刷新间隔 (毫秒)"
        },
        "claudeTaskMonitor.livenessCheckIntervalMs": {
          "type": "number",
          "default": 5000,
          "description": "进程活性检测间隔 (毫秒);用于把 Ctrl+Z / 异常退出的 CLI 从侧边栏移除"
        },
        "claudeTaskMonitor.notifyAggregateMode": {
          "type": "string",
          "enum": ["perSession", "aggregate"],
          "default": "aggregate",
          "description": "等待权限通知模式:perSession 每条会话单独弹(老行为);aggregate N≥2 时合并成一条"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:integration": "tsc -p tsconfig.integration.json",
    "test:integration": "pnpm build && pnpm build:integration && node ./dist-test/runTest.js",
    "package": "vsce package --no-dependencies && mkdir -p packages && mv *.vsix packages/",
    "vscode:prepublish": "pnpm build"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.0",
    "@vscode/test-electron": "^2.3.0",
    "glob": "^9.0.0",
    "mocha": "^10.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "vsce": "^2.15.0"
  }
}
